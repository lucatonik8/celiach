---
import { Image } from 'astro:assets';
import firma from '../assets/firma-alpha.png';
import v1a from '../assets/looks/look07-1.jpg';
import v2a from '../assets/media/l0rna/03.webp';
import v2b from '../assets/media/amadecaza/01.jpg';
import v2c from '../assets/media/tiago/05.webp';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const versions = [
  {
    n: '01',
    href: `${base}/v1/`,
    name: 'Archivo',
    date: '09.11.2026',
    desc: 'Ficha técnica en monoespaciada, índice y galerías limpias. Sobria y rápida.',
    tags: ['Estática', 'Ficha', 'Índice'],
    imgs: [v1a],
  },
  {
    n: '02',
    href: `${base}/v2/`,
    name: 'Archivo animado',
    date: '10.11.2026',
    desc: 'Portada con marco de fotos que se abre, raíl numerado, fichas de inventario con polaroid, páginas de revista, recortes de periódico que giran, galerías que avanzan con el scroll y videoclips integrados.',
    tags: ['Scroll', 'Revista', 'Polaroid', 'Media web'],
    imgs: [v2a, v2b, v2c],
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Celia Luengo Villa — Versiones</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <header>
        <Image src={firma} alt="Celia Luengo Villa" class="firma" widths={[320, 640]} sizes="260px" loading="eager" />
        <p>[LANZADOR]<br />PORTFOLIO — VERSIONES</p>
      </header>
      <ol>
        {versions.map((v) => (
          <li>
            <a href={v.href}>
              <span class="n">[V{v.n}]</span>
              <span class="pics">
                {v.imgs.map((src, i) => (
                  <Image src={src} alt="" width={360} format="webp" style={`--i:${i}`} />
                ))}
              </span>
              <span class="body">
                <span class="name">{v.name}</span>
                <span class="desc">{v.desc}</span>
                <span class="tags">{v.tags.map((t) => <i>{t}</i>)}</span>
              </span>
              <span class="go">{v.date}<b>Abrir →</b></span>
            </a>
          </li>
        ))}
      </ol>
      <p class="foot">ARCHIVO 2026 · {versions.length} VERSIONES</p>
    </main>
    <style is:global>
      :root { --ink: #161514; --mute: #8a8782; --line: #d9d5ce; --bg: #f4f2ed; color-scheme: light; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 400 14px/1.6 'Courier Prime', monospace; overflow-x: clip; }
      main { max-width: 980px; margin: 0 auto; padding: clamp(2.5rem, 8vw, 6rem) clamp(16px, 4vw, 48px); }
      header { text-align: center; margin-bottom: clamp(2.5rem, 7vw, 5rem); }
      .firma { width: min(260px, 60vw); height: auto; margin: 0 auto; display: block; mix-blend-mode: multiply; }
      header p { font-size: 0.72rem; letter-spacing: 0.14em; margin: 0.8rem 0 0; }
      ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
      li { border-bottom: 1px solid var(--line); }
      a { display: grid; grid-template-columns: 4rem 180px 1fr auto; gap: 1.5rem; align-items: center; padding: 1.6rem 0; color: inherit; text-decoration: none; transition: background 0.3s, padding 0.3s; }
      a:hover { background: #fbfaf7; padding-inline: 1rem; }
      .n { color: var(--mute); font-size: 0.8rem; }
      .pics { position: relative; height: 120px; }
      .pics img { position: absolute; top: 0; left: calc(var(--i) * 34px); height: 120px; width: auto; aspect-ratio: 3 / 4; object-fit: cover; rotate: calc((var(--i) - 1) * 4deg); box-shadow: 0 2px 8px rgb(0 0 0 / 0.12); transition: translate 0.4s, rotate 0.4s; }
      a:hover .pics img { translate: calc(var(--i) * 18px) -4px; rotate: calc((var(--i) - 1) * 8deg); }
      .body { display: grid; gap: 0.4rem; }
      .name { font-family: 'Instrument Serif', serif; font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1; }
      .desc { color: #5f5c57; font-size: 0.8rem; max-width: 52ch; }
      .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .tags i { font-style: normal; font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; border: 1px solid var(--line); padding: 0.1rem 0.45rem; }
      .go { display: grid; text-align: right; font-size: 0.66rem; color: var(--mute); letter-spacing: 0.08em; gap: 0.3rem; }
      .go b { color: var(--ink); font-size: 0.8rem; text-transform: uppercase; }
      .foot { text-align: center; color: var(--mute); font-size: 0.68rem; letter-spacing: 0.14em; margin-top: 3rem; }
      @media (max-width: 700px) {
        a { grid-template-columns: 1fr; gap: 0.9rem; }
        .n { order: -1; }
        .go { text-align: left; grid-auto-flow: column; justify-content: space-between; }
      }
    </style>
  </body>
</html>
